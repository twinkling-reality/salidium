{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:salidium:consumer:1:session-feed",
  "title": "salidium.session-feed",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "salidium.session-feed"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "resync"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
          "description": "UTC, millisecond precision, trailing Z. Lexicographic order is time order."
        },
        "reason": {
          "type": "string",
          "const": "connected"
        }
      },
      "required": [
        "format",
        "version",
        "type",
        "at",
        "reason"
      ]
    },
    {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "salidium.session-feed"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "session.changed"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
          "description": "UTC, millisecond precision, trailing Z. Lexicographic order is time order."
        },
        "sessionId": {
          "type": "string",
          "maxLength": 1100
        },
        "native": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "pattern": "^(?:claude-code|codex|[a-z][a-z0-9-]{0,62}\\/[a-z][a-z0-9-]{0,62})$",
              "description": "claude-code, codex, or a namespaced owner/name extension provider."
            },
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
              "description": "The provider's own session id, exactly as the provider wrote it."
            }
          },
          "required": [
            "provider",
            "sessionId"
          ],
          "description": "The key any tool that launched a session already has. Look a session up by it with the lookup endpoint."
        },
        "evidenceSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "type": "string",
          "enum": [
            "working",
            "idle",
            "waiting",
            "ended",
            "unknown"
          ],
          "description": "As of generatedAt. A working session silent for fifteen minutes reads idle, so status can change with time alone."
        },
        "explanation": {
          "type": "string",
          "enum": [
            "generated",
            "generating",
            "disabled",
            "unavailable",
            "failed",
            "none"
          ],
          "description": "Outcome of the most recent explanation attempt; none when there has been no attempt. Whether an explanation covers the newest evidence is the report field explanation.current."
        }
      },
      "required": [
        "format",
        "version",
        "type",
        "at",
        "sessionId",
        "native",
        "evidenceSeq",
        "status",
        "explanation"
      ]
    },
    {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "salidium.session-feed"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "session.removed"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
          "description": "UTC, millisecond precision, trailing Z. Lexicographic order is time order."
        },
        "sessionId": {
          "type": "string",
          "maxLength": 1100
        },
        "native": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "pattern": "^(?:claude-code|codex|[a-z][a-z0-9-]{0,62}\\/[a-z][a-z0-9-]{0,62})$",
                  "description": "claude-code, codex, or a namespaced owner/name extension provider."
                },
                "sessionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
                  "description": "The provider's own session id, exactly as the provider wrote it."
                }
              },
              "required": [
                "provider",
                "sessionId"
              ],
              "description": "The key any tool that launched a session already has. Look a session up by it with the lookup endpoint."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format",
        "version",
        "type",
        "at",
        "sessionId",
        "native"
      ]
    },
    {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "salidium.session-feed"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "heartbeat"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
          "description": "UTC, millisecond precision, trailing Z. Lexicographic order is time order."
        }
      },
      "required": [
        "format",
        "version",
        "type",
        "at"
      ]
    },
    {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "salidium.session-feed"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "closing"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
          "description": "UTC, millisecond precision, trailing Z. Lexicographic order is time order."
        },
        "reason": {
          "type": "string",
          "enum": [
            "credential-revoked",
            "shutting-down"
          ]
        }
      },
      "required": [
        "format",
        "version",
        "type",
        "at",
        "reason"
      ]
    }
  ]
}
