{
  "name": "@salidium/consumer-contract",
  "version": "1.1.0-rc.0",
  "description": "Versioned, read-only local contract for reading Salidium session reports: types, runtime schemas, JSON Schema, and fixtures.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/v1/*.json": "./schema/v1/*.json",
    "./fixtures/v1/*.json": "./fixtures/v1/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinkling-reality/salidium.git",
    "directory": "packages/consumer-contract"
  }
}
