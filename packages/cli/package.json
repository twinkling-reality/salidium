{
  "name": "salidium",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "bundle"
  ],
  "scripts": {
    "build": "tsc --build",
    "bundle": "node build.mjs",
    "prepack": "node build.mjs",
    "test": "vitest run --root ../.."
