    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/twinkling-reality/salidium/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "coding-agent",
    "observability",
    "cli",
    "local-first"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@salidium/adapter-kit": "workspace:*",
